+# Copiá este archivo a .env y completá los valores. NO subas el .env a GitHub.
+
+# "mongo" (real) o "memoria" (demo sin base, solo desarrollo; no se permite con NODE_ENV=production)
+PERSISTENCIA=mongo
+MONGODB_URI=mongodb+srv://USUARIO:CLAVE@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
+MONGODB_DB=SistemaBRIE
+
+# OBLIGATORIO con PERSISTENCIA=mongo (mínimo 32 caracteres). Generalo con:
+#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
+JWT_SECRET=
+
+PORT=3000
+# NODE_ENV=production   # activa cookie "secure" (HTTPS) y bloquea el modo memoria
+# CORS_ORIGIN=https://mi-front.com   # solo si el front está en OTRO dominio
+# HORA_CORTE=10   # hora (0-23) del corte de producción; luego se cambia desde Administración
+# SEED_ADMIN_EMAIL=admin@brie.local
+# SEED_ADMIN_PASSWORD=
