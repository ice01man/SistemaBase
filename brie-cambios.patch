+// Error "esperado" con código HTTP. Los controllers/servicios lo lanzan y el
+// manejador global de app.js lo convierte en { error } con ese status.
+export class ErrorHttp extends Error {
+  constructor(status, mensaje) {
+    super(mensaje);
+    this.status = status;
+  }
+}
+
+export const badRequest = (m) => new ErrorHttp(400, m);
+export const noAutorizado = (m = 'No autenticado') => new ErrorHttp(401, m);
+export const prohibido = (m = 'No tenés permisos para esta acción') => new ErrorHttp(403, m);
+export const noEncontrado = (m = 'No encontrado') => new ErrorHttp(404, m);
+export const conflicto = (m) => new ErrorHttp(409, m);
+
+// ---- Validadores chicos (evitan que lleguen objetos {$ne:..} donde va un string) ----
+export function texto(valor, campo, { min = 1, max = 200, requerido = true } = {}) {
+  if (valor === undefined || valor === null || valor === '') {
+    if (requerido) throw badRequest(`Falta ${campo}.`);
+    return '';
+  }
+  if (typeof valor !== 'string') throw badRequest(`${campo} inválido.`);
+  const v = valor.trim();
+  if (requerido && v.length < min) throw badRequest(`${campo} es demasiado corto.`);
+  if (v.length > max) throw badRequest(`${campo} es demasiado largo (máx. ${max}).`);
+  return v;
+}
+
+export function numero(valor, campo, { min = 0, max = 1e9, entero = false } = {}) {
+  const n = Number(valor);
+  if (valor === '' || valor === null || valor === undefined || !Number.isFinite(n)) {
+    throw badRequest(`${campo} debe ser un número.`);
+  }
+  if (entero && !Number.isInteger(n)) throw badRequest(`${campo} debe ser un número entero.`);
+  if (n < min || n > max) throw badRequest(`${campo} debe estar entre ${min} y ${max}.`);
+  return n;
+}
+
+export const esEmail = (s) => typeof s === 'string' && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(s) && s.length <= 120;
diff --git a/src/utils/fecha.js b/src/utils/fecha.js
new file mode 100644
index 0000000..afdffda
--- /dev/null
+++ b/src/utils/fecha.js
@@ -0,0 +1,54 @@
+// Fechas de negocio. Todo se maneja en hora de Argentina y las fechas de entrega
+// se guardan como texto 'YYYY-MM-DD' (así no hay problemas de zona horaria al comparar).
+const TZ = 'America/Argentina/Buenos_Aires';
+const DIAS_SEMANA = ['domingo', 'lunes', 'martes', 'miercoles', 'jueves', 'viernes', 'sabado'];
+
+const fmt = new Intl.DateTimeFormat('en-CA', {
+  timeZone: TZ, year: 'numeric', month: '2-digit', day: '2-digit',
+  hour: '2-digit', minute: '2-digit', hourCycle: 'h23',
+});
+
+/** "Ahora" en Argentina. BRIE_FAKE_NOW (ISO) permite fijar el reloj en las pruebas. */
+export function ahora(fecha = null) {
+  const base = fecha ?? (process.env.BRIE_FAKE_NOW ? new Date(process.env.BRIE_FAKE_NOW) : new Date());
+  const p = Object.fromEntries(fmt.formatToParts(base).map((x) => [x.type, x.value]));
+  const fechaTxt = `${p.year}-${p.month}-${p.day}`;
+  return {
+    fecha: fechaTxt,
+    hora: Number(p.hour),
+    minuto: Number(p.minute),
+    dow: new Date(`${fechaTxt}T12:00:00Z`).getUTCDay(),
+    dia: DIAS_SEMANA[new Date(`${fechaTxt}T12:00:00Z`).getUTCDay()],
+  };
+}
+
+export const esFecha = (s) => typeof s === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(s) && !Number.isNaN(Date.parse(`${s}T12:00:00Z`));
+
+export function sumarDias(fecha, n) {
+  const d = new Date(`${fecha}T12:00:00Z`);
+  d.setUTCDate(d.getUTCDate() + n);
+  return d.toISOString().slice(0, 10);
+}
+
+export const diaDeFecha = (fecha) => DIAS_SEMANA[new Date(`${fecha}T12:00:00Z`).getUTCDay()];
+
+/**
+ * Próxima fecha de entrega para un día de menú.
+ * Si el día pedido es hoy y ya pasó la hora de corte, se entrega la semana que viene.
+ */
+export function fechaDeEntrega(dia, horaCorte, ref = ahora()) {
+  const objetivo = DIAS_SEMANA.indexOf(dia);
+  if (objetivo < 0) return null;
+  let delta = (objetivo - ref.dow + 7) % 7;
+  if (delta === 0 && ref.hora >= horaCorte) delta = 7;
+  return sumarDias(ref.fecha, delta);
+}
+
+/** ¿Todavía se puede modificar/cancelar un pedido con esa fecha de entrega? */
+export function antesDelCorte(fechaEntrega, horaCorte, ref = ahora()) {
+  if (fechaEntrega > ref.fecha) return true;
+  if (fechaEntrega === ref.fecha) return ref.hora < horaCorte;
+  return false;
+}
+
+export const hoy = () => ahora().fecha;
