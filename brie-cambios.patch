diff --git a/src/services/pedidos.js b/src/services/pedidos.js
new file mode 100644
index 0000000..b37ceeb
--- /dev/null
+++ b/src/services/pedidos.js
@@ -0,0 +1,169 @@
+import { db, obtenerConfig } from '../store/index.js';
+import { ahora, antesDelCorte, esFecha, fechaDeEntrega } from '../utils/fecha.js';
+import { ErrorHttp, badRequest, conflicto, noEncontrado, prohibido, texto, numero } from '../utils/errores.js';
+import { ROLES_COCINA, ROLES_REPARTO } from '../middleware/auth.js';
+import { consumoDePedidos } from './produccion.js';
+import { reponerInsumo } from './stock.js';
+
+const DIAS_MENU = ['lunes', 'martes', 'miercoles', 'jueves', 'viernes'];
+
+// estado destino → { desde, roles que pueden hacerlo }
+const TRANSICIONES = {
+  en_preparacion: { desde: 'confirmado',     roles: ROLES_COCINA },
+  producido:      { desde: 'en_preparacion', roles: ROLES_COCINA },
+  en_camino:      { desde: 'producido',      roles: ROLES_REPARTO },
+  entregado:      { desde: 'en_camino',      roles: ROLES_REPARTO },
+};
+
+const decorar = (p, horaCorte) => ({
+  ...p,
+  puedeCancelar: p.estado === 'confirmado' && !p.stockDescontado && antesDelCorte(p.fechaEntrega, horaCorte),
+});
+
+/** Fechas de entrega de cada día del menú (para mostrar "Entrega: miércoles 12/11" en el carrito). */
+export async function fechasDeEntrega() {
+  const { horaCorte } = await obtenerConfig();
+  const ref = ahora();
+  return { horaCorte, hoy: ref.fecha, entregas: Object.fromEntries(DIAS_MENU.map((d) => [d, fechaDeEntrega(d, horaCorte, ref)])) };
+}
+
+/**
+ * Crea un pedido. IMPORTANTE: el cliente solo manda QUÉ y CUÁNTO (productId + qty).
+ * Nombre, precio y total se leen de la base: lo que mande el navegador se ignora.
+ */
+export async function crearPedido(actor, body) {
+  const dia = body?.dia;
+  if (!DIAS_MENU.includes(dia)) throw badRequest('Elegí un día del menú (lunes a viernes).');
+  if (!Array.isArray(body?.items) || body.items.length === 0) throw badRequest('Carrito vacío.');
+  if (body.items.length > 30) throw badRequest('Demasiados platos distintos en un pedido.');
+
+  const pedidos = new Map(); // productId -> qty (si repiten el plato, se suman)
+  for (const it of body.items) {
+    const id = texto(String(it?.productId ?? ''), 'El plato', { max: 40 });
+    const qty = numero(it?.qty, 'La cantidad', { min: 1, max: 50, entero: true });
+    pedidos.set(id, (pedidos.get(id) || 0) + qty);
+  }
+
+  const items = [];
+  let total = 0;
+  for (const [id, qty] of pedidos) {
+    if (qty > 50) throw badRequest('Máximo 50 unidades por plato.');
+    const p = await db.products.get(id);
+    if (!p || p.activo === false) throw badRequest('Un plato del carrito ya no está disponible. Actualizá el menú.');
+    if (p.day !== dia) throw badRequest(`"${p.name}" no es del menú del ${dia}.`);
+    items.push({ productId: String(p._id), name: p.name, price: p.price, qty });
+    total += p.price * qty;
+  }
+
+  const user = await db.users.get(actor.id);
+  if (!user) throw noEncontrado('Usuario no encontrado');
+  const direccion = texto(body.direccion || user.direccion || '', 'La dirección de entrega', { max: 200 });
+  const observaciones = texto(body.observaciones ?? '', 'Las observaciones', { max: 300, requerido: false });
+  const medioPago = body.medioPago ?? 'efectivo';
+  if (!['efectivo', 'transferencia'].includes(medioPago)) throw badRequest('Medio de pago inválido.');
+
+  const { horaCorte } = await obtenerConfig();
+  const fechaEntrega = fechaDeEntrega(dia, horaCorte);
+  const ahoraIso = new Date();
+  const pedido = await db.orders.create({
+    numero: await db.siguienteNumero('pedido'),
+    userId: String(user._id),
+    cliente: { nombre: user.nombre, email: user.email, telefono: user.telefono || '' },
+    items, totalAmount: total, estado: 'confirmado',
+    diaMenu: dia, fechaEntrega, direccion, observaciones, medioPago,
+    pagado: false, stockDescontado: false, tomadoPor: null, repartidor: null, motivoCancelacion: '',
+    historial: [{ estado: 'confirmado', fecha: ahoraIso, por: user.nombre || user.email }],
+  });
+  return decorar(pedido, horaCorte);
+}
+
+export async function misPedidos(userId) {
+  const { horaCorte } = await obtenerConfig();
+  const lista = await db.orders.list({ userId }, { sort: { createdAt: -1 } });
+  return lista.map((p) => decorar(p, horaCorte));
+}
+
+export async function obtenerPedido(id, actor) {
+  const p = await db.orders.get(id);
+  if (!p) throw noEncontrado('Pedido no encontrado');
+  const esDueno = String(p.userId) === String(actor.id);
+  if (!esDueno && actor.rol === 'cliente') throw prohibido();
+  return decorar(p, (await obtenerConfig()).horaCorte);
+}
+
+export async function listarPedidos({ estados, fecha, limit = 300, desc = false } = {}) {
+  const filtro = {};
+  if (estados?.length) filtro.estado = { $in: estados };
+  if (fecha) {
+    if (!esFecha(fecha)) throw badRequest('Fecha inválida (usá AAAA-MM-DD).');
+    filtro.fechaEntrega = fecha;
+  }
+  return db.orders.list(filtro, { sort: { createdAt: desc ? -1 : 1 }, limit });
+}
+
+/** Avanza un pedido por el flujo cocina → producción → reparto, validando rol y estado de origen. */
+export async function cambiarEstado(id, actor, nuevo) {
+  const t = TRANSICIONES[nuevo];
+  if (!t) throw badRequest('Estado inválido. Para cancelar usá la acción "cancelar".');
+  if (!t.roles.includes(actor.rol)) throw prohibido(`Tu rol no puede pasar un pedido a "${nuevo}".`);
+  const p = await db.orders.get(id);
+  if (!p) throw noEncontrado('Pedido no encontrado');
+  if (p.estado !== t.desde) {
+    throw conflicto(`El pedido está "${p.estado}": no se puede pasar a "${nuevo}" (tiene que estar "${t.desde}").`);
+  }
+  const quien = actor.nombre || actor.email;
+  const patch = {
+    estado: nuevo,
+    historial: [...(p.historial || []), { estado: nuevo, fecha: new Date(), por: quien }],
+  };
+  if (nuevo === 'en_preparacion') patch.tomadoPor = quien;
+  if (nuevo === 'en_camino') patch.repartidor = quien;
+  if (nuevo === 'entregado' && p.medioPago === 'efectivo') patch.pagado = true; // se cobra al entregar
+  // Compare-and-set: si dos personas lo toman a la vez, solo una gana.
+  const upd = await db.orders.updateOne({ _id: p._id, estado: t.desde }, patch);
+  if (!upd) throw conflicto('Otro usuario acaba de cambiar este pedido. Actualizá la lista.');
+  return upd;
+}
+
+export async function marcarPago(id, pagado) {
+  const upd = await db.orders.update(id, { pagado: !!pagado });
+  if (!upd) throw noEncontrado('Pedido no encontrado');
+  return upd;
+}
+
+/**
+ * Cancela un pedido.
+ *  - Cliente: solo el suyo, solo si sigue "confirmado" y antes del corte de producción.
+ *  - Admin: cualquiera que no esté entregado/cancelado. Si ya se descontó stock, se devuelve.
+ */
+export async function cancelarPedido(id, actor, motivo = '') {
+  const p = await db.orders.get(id);
+  if (!p) throw noEncontrado('Pedido no encontrado');
+  const esAdmin = actor.rol === 'admin';
+  if (!esAdmin) {
+    if (String(p.userId) !== String(actor.id)) throw prohibido();
+    const { horaCorte } = await obtenerConfig();
+    if (p.estado !== 'confirmado' || p.stockDescontado || !antesDelCorte(p.fechaEntrega, horaCorte)) {
+      throw conflicto('Este pedido ya no se puede cancelar (pasó el corte de producción o ya está en preparación).');
+    }
+  }
+  if (['entregado', 'cancelado'].includes(p.estado)) throw conflicto(`El pedido ya está "${p.estado}".`);
+
+  const quien = actor.nombre || actor.email;
+  const upd = await db.orders.updateOne({ _id: p._id, estado: p.estado }, {
+    estado: 'cancelado',
+    motivoCancelacion: texto(motivo ?? '', 'El motivo', { max: 200, requerido: false }) || (esAdmin ? 'Cancelado por administración' : 'Cancelado por el cliente'),
+    historial: [...(p.historial || []), { estado: 'cancelado', fecha: new Date(), por: quien }],
+  });
+  if (!upd) throw conflicto('El pedido cambió mientras lo cancelabas. Actualizá y reintentá.');
+
+  if (p.stockDescontado) { // devolver al stock lo que ya se había consumido
+    const { consumo, insumos } = await consumoDePedidos([p]);
+    for (const [insId, cant] of consumo) {
+      await reponerInsumo(insumos.get(insId), Math.round(cant * 1000) / 1000, `Cancelación pedido #${p.numero}`, quien);
+    }
+  }
+  return upd;
+}
+
+export { ErrorHttp };
diff --git a/src/services/produccion.js b/src/services/produccion.js
new file mode 100644
index 0000000..df10249
--- /dev/null
+++ b/src/services/produccion.js
@@ -0,0 +1,130 @@
+// Proceso P3 — Corte de producción: a la hora de corte se "congela" el día,
+// se calcula cuánto insumo consumen los pedidos y se descuenta del stock.
+import { db, obtenerConfig } from '../store/index.js';
+import { ahora, esFecha } from '../utils/fecha.js';
+import { badRequest } from '../utils/errores.js';
+import { consumirInsumo, alertasDeStock } from './stock.js';
+
+const redondear = (n) => Math.round(n * 1000) / 1000;
+let corteEnCurso = false;
+
+/** Suma insumos que consumen unos pedidos según la receta de cada plato. */
+export async function consumoDePedidos(pedidos) {
+  const productos = new Map((await db.products.list({})).map((p) => [String(p._id), p]));
+  const insumos = new Map((await db.insumos.list({})).map((i) => [String(i._id), i]));
+  const consumo = new Map();      // insumoId -> cantidad
+  const sinReceta = new Set();    // nombres de platos sin receta cargada
+  for (const ped of pedidos) {
+    for (const it of ped.items) {
+      const prod = productos.get(String(it.productId));
+      if (!prod || !(prod.receta || []).length) { sinReceta.add(it.name); continue; }
+      for (const r of prod.receta) {
+        if (!insumos.has(String(r.insumo))) continue;
+        consumo.set(String(r.insumo), (consumo.get(String(r.insumo)) || 0) + r.cantidad * it.qty);
+      }
+    }
+  }
+  return { consumo, insumos, sinReceta: [...sinReceta] };
+}
+
+/** Lo que tiene que producir la cocina para una fecha de entrega. */
+export async function listaDeProduccion(fecha) {
+  if (!esFecha(fecha)) throw badRequest('Fecha inválida (usá AAAA-MM-DD).');
+  const pedidos = await db.orders.list({ fechaEntrega: fecha, estado: { $ne: 'cancelado' } });
+
+  const porPlato = new Map();
+  for (const p of pedidos) for (const it of p.items) {
+    const k = String(it.productId);
+    const f = porPlato.get(k) || { productId: k, name: it.name, qty: 0, pedidos: 0 };
+    f.qty += it.qty; f.pedidos += 1;
+    porPlato.set(k, f);
+  }
+
+  const pendientes = pedidos.filter((p) => !p.stockDescontado);
+  const { consumo: aDescontar, insumos, sinReceta } = await consumoDePedidos(pendientes);
+  const { consumo: total } = await consumoDePedidos(pedidos);
+
+  const filas = [...total.entries()].map(([id, necesarioTotal]) => {
+    const i = insumos.get(id);
+    const pend = aDescontar.get(id) || 0;
+    return {
+      insumo: id, nombre: i.nombre, unidad: i.unidad, stock_actual: redondear(i.stock_actual),
+      necesario_total: redondear(necesarioTotal), a_descontar: redondear(pend),
+      faltante: redondear(Math.max(0, pend - i.stock_actual)),
+    };
+  }).sort((a, b) => a.nombre.localeCompare(b.nombre));
+
+  const porEstado = {};
+  for (const p of pedidos) porEstado[p.estado] = (porEstado[p.estado] || 0) + 1;
+
+  return {
+    fecha,
+    pedidos: pedidos.length,
+    porEstado,
+    platos: [...porPlato.values()].sort((a, b) => b.qty - a.qty),
+    insumos: filas,
+    sinReceta,
+    corteEjecutado: pedidos.length > 0 && pendientes.length === 0,
+    pedidosPendientesDeDescuento: pendientes.length,
+  };
+}
+
+/**
+ * Ejecuta el corte para una fecha: descuenta insumos de todos los pedidos no cancelados
+ * que todavía no se descontaron. Es seguro correrlo dos veces (no descuenta doble).
+ */
+export async function ejecutarCorte(fecha, por = 'sistema') {
+  if (!esFecha(fecha)) throw badRequest('Fecha inválida (usá AAAA-MM-DD).');
+  if (corteEnCurso) throw badRequest('Ya hay un corte en curso. Esperá unos segundos.');
+  corteEnCurso = true;
+  const reclamados = [];
+  try {
+    const candidatos = await db.orders.list({ fechaEntrega: fecha, stockDescontado: false, estado: { $ne: 'cancelado' } });
+    for (const p of candidatos) {
+      // Compare-and-set: si otro proceso ya lo tomó, no lo contamos dos veces.
+      const ok = await db.orders.updateOne({ _id: p._id, stockDescontado: false, estado: { $ne: 'cancelado' } }, { stockDescontado: true });
+      if (ok) reclamados.push(p);
+    }
+    const { consumo, insumos, sinReceta } = await consumoDePedidos(reclamados);
+    const motivo = `Corte de producción ${fecha}`;
+    const consumos = [];
+    const faltantes = [];
+    try {
+      for (const [id, cant] of consumo) {
+        const ins = await db.insumos.get(id);
+        const r = await consumirInsumo(ins, redondear(cant), motivo, por);
+        consumos.push({ insumo: id, nombre: ins.nombre, unidad: ins.unidad, consumido: r.consumido, stock: r.stock });
+        if (r.faltante > 0) faltantes.push({ insumo: id, nombre: ins.nombre, unidad: ins.unidad, faltante: r.faltante });
+      }
+    } catch (e) {
+      for (const p of reclamados) await db.orders.update(p._id, { stockDescontado: false }); // deshacer marcas
+      throw e;
+    }
+    return {
+      fecha, pedidosProcesados: reclamados.length, consumos, faltantes, sinReceta,
+      alertas: (await alertasDeStock()).map((i) => ({ nombre: i.nombre, unidad: i.unidad, stock_actual: i.stock_actual, stock_minimo: i.stock_minimo })),
+    };
+  } finally {
+    corteEnCurso = false;
+  }
+}
+
+/** Corte automático diario (sin dependencias): revisa cada minuto si ya es la hora. */
+export function programarCorteDiario() {
+  const revisar = async () => {
+    try {
+      const cfg = await obtenerConfig();
+      const t = ahora();
+      const laboral = t.dow >= 1 && t.dow <= 5;
+      if (laboral && t.hora >= cfg.horaCorte && cfg.ultimoCorte !== t.fecha) {
+        const r = await ejecutarCorte(t.fecha, 'sistema');
+        await db.config.update(cfg._id, { ultimoCorte: t.fecha });
+        console.log(`⏱️  Corte automático ${t.fecha}: ${r.pedidosProcesados} pedidos, ${r.faltantes.length} faltantes`);
+      }
+    } catch (e) {
+      console.error('❌ Corte automático falló:', e.message);
+    }
+  };
+  setTimeout(revisar, 5000).unref();
+  setInterval(revisar, 60 * 1000).unref();
+}
diff --git a/src/services/productos.js b/src/services/productos.js
new file mode 100644
index 0000000..16de84e
--- /dev/null
+++ b/src/services/productos.js
@@ -0,0 +1,68 @@
+import { db } from '../store/index.js';
+import { badRequest, noEncontrado, texto, numero } from '../utils/errores.js';
+
+const DIAS = ['lunes', 'martes', 'miercoles', 'jueves', 'viernes', 'sabado', 'domingo'];
+
+async function validarReceta(receta) {
+  if (receta === undefined) return undefined;
+  if (!Array.isArray(receta)) throw badRequest('La receta debe ser una lista.');
+  const vistos = new Set();
+  const out = [];
+  for (const r of receta) {
+    const id = String(r?.insumo ?? r?.insumoId ?? '');
+    const cantidad = numero(r?.cantidad, 'La cantidad de la receta', { min: 0.0001, max: 1e5 });
+    if (vistos.has(id)) throw badRequest('Un insumo está repetido en la receta.');
+    vistos.add(id);
+    if (!(await db.insumos.get(id))) throw badRequest('La receta tiene un insumo que no existe.');
+    out.push({ insumo: id, cantidad });
+  }
+  return out;
+}
+
+export async function validarProducto(d, parcial = false) {
+  const out = {};
+  const campo = (k) => !parcial || d[k] !== undefined;
+  if (campo('name')) out.name = texto(d.name, 'El nombre', { max: 100 });
+  if (campo('category')) out.category = texto(d.category, 'La categoría', { max: 40 });
+  if (campo('day')) {
+    if (!DIAS.includes(d.day)) throw badRequest('Día inválido.');
+    out.day = d.day;
+  }
+  if (campo('description')) out.description = texto(d.description, 'La descripción', { max: 400 });
+  if (campo('image')) out.image = texto(d.image, 'La imagen', { max: 500 });
+  if (campo('price')) out.price = numero(d.price, 'El precio', { min: 0, max: 1e7 });
+  if (d.ingredients !== undefined) {
+    if (!Array.isArray(d.ingredients)) throw badRequest('Los ingredientes deben ser una lista.');
+    out.ingredients = d.ingredients.map((x) => texto(x, 'Ingrediente', { max: 80 }));
+  }
+  if (d.tags !== undefined) {
+    if (!Array.isArray(d.tags)) throw badRequest('Los tags deben ser una lista.');
+    out.tags = d.tags.map((x) => texto(x, 'Tag', { max: 40 }));
+  }
+  if (d.destacado !== undefined) out.destacado = d.destacado ? texto(d.destacado, 'El badge', { max: 40 }) : null;
+  if (d.rating !== undefined) {
+    out.rating = {
+      promedio: numero(d.rating?.promedio ?? 0, 'El rating', { min: 0, max: 5 }),
+      cantidad: numero(d.rating?.cantidad ?? 0, 'La cantidad de reseñas', { min: 0, max: 1e7, entero: true }),
+    };
+  }
+  if (d.activo !== undefined) out.activo = !!d.activo;
+  const receta = await validarReceta(d.receta);
+  if (receta !== undefined) out.receta = receta;
+  return out;
+}
+
+export async function crearProducto(d) {
+  return db.products.create({ activo: true, ...(await validarProducto(d)) });
+}
+
+export async function editarProducto(id, d) {
+  const p = await db.products.update(id, await validarProducto(d, true));
+  if (!p) throw noEncontrado('Producto no encontrado');
+  return p;
+}
+
+export async function borrarProducto(id) {
+  if (!(await db.products.remove(id))) throw noEncontrado('Producto no encontrado');
+  return { message: 'Producto eliminado' };
+}
diff --git a/src/services/reportes.js b/src/services/reportes.js
new file mode 100644
