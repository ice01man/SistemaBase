+++ b/src/services/reportes.js
@@ -0,0 +1,47 @@
+import { db } from '../store/index.js';
+import { ahora, esFecha, sumarDias } from '../utils/fecha.js';
+import { badRequest } from '../utils/errores.js';
+import { alertasDeStock } from './stock.js';
+
+/** Resumen para el tablero del admin. Rango por fecha de entrega (por defecto, últimos 30 días). */
+export async function resumen({ desde, hasta } = {}) {
+  const hoy = ahora().fecha;
+  hasta = hasta || sumarDias(hoy, 14);
+  desde = desde || sumarDias(hoy, -30);
+  if (!esFecha(desde) || !esFecha(hasta)) throw badRequest('Fechas inválidas (usá AAAA-MM-DD).');
+
+  const pedidos = await db.orders.list({ fechaEntrega: { $gte: desde, $lte: hasta } });
+  const validos = pedidos.filter((p) => p.estado !== 'cancelado');
+
+  const porEstado = {};
+  for (const p of pedidos) porEstado[p.estado] = (porEstado[p.estado] || 0) + 1;
+
+  const ventas = validos.reduce((a, p) => a + p.totalAmount, 0);
+  const cobrado = validos.filter((p) => p.pagado).reduce((a, p) => a + p.totalAmount, 0);
+
+  const platos = new Map();
+  for (const p of validos) for (const it of p.items) {
+    const f = platos.get(it.name) || { name: it.name, qty: 0, monto: 0 };
+    f.qty += it.qty; f.monto += it.qty * it.price;
+    platos.set(it.name, f);
+  }
+
+  const porFecha = new Map();
+  for (const p of validos) {
+    const f = porFecha.get(p.fechaEntrega) || { fecha: p.fechaEntrega, pedidos: 0, monto: 0 };
+    f.pedidos += 1; f.monto += p.totalAmount;
+    porFecha.set(p.fechaEntrega, f);
+  }
+
+  return {
+    desde, hasta, hoy,
+    pedidos: pedidos.length,
+    pedidosValidos: validos.length,
+    ventas, cobrado, porCobrar: ventas - cobrado,
+    ticketPromedio: validos.length ? Math.round(ventas / validos.length) : 0,
+    porEstado,
+    topPlatos: [...platos.values()].sort((a, b) => b.qty - a.qty).slice(0, 8),
+    porFecha: [...porFecha.values()].sort((a, b) => a.fecha.localeCompare(b.fecha)),
+    alertasStock: (await alertasDeStock()).length,
+  };
+}
diff --git a/src/services/stock.js b/src/services/stock.js
new file mode 100644
index 0000000..c849f91
--- /dev/null
+++ b/src/services/stock.js
@@ -0,0 +1,119 @@
+import { db } from '../store/index.js';
+import { badRequest, noEncontrado, texto, numero, conflicto } from '../utils/errores.js';
+
+const UNIDADES = ['kg', 'g', 'l', 'ml', 'u'];
+const redondear = (n) => Math.round(n * 1000) / 1000;
+
+export const conAlerta = (i) => ({ ...i, bajoMinimo: i.activo !== false && i.stock_actual < i.stock_minimo });
+
+export async function listarInsumos({ soloActivos = false } = {}) {
+  const lista = await db.insumos.list(soloActivos ? { activo: true } : {}, { sort: { nombre: 1 } });
+  return lista.map(conAlerta);
+}
+
+export async function alertasDeStock() {
+  return (await listarInsumos({ soloActivos: true })).filter((i) => i.bajoMinimo);
+}
+
+function validarInsumo(d, parcial = false) {
+  const out = {};
+  if (!parcial || d.nombre !== undefined) out.nombre = texto(d.nombre, 'El nombre', { max: 80 });
+  if (!parcial || d.unidad !== undefined) {
+    if (!UNIDADES.includes(d.unidad)) throw badRequest(`Unidad inválida (${UNIDADES.join(', ')}).`);
+    out.unidad = d.unidad;
+  }
+  if (!parcial || d.stock_minimo !== undefined) out.stock_minimo = numero(d.stock_minimo ?? 0, 'El stock mínimo', { max: 1e7 });
+  if (!parcial || d.costo_unitario !== undefined) out.costo_unitario = numero(d.costo_unitario ?? 0, 'El costo', { max: 1e9 });
+  if (d.activo !== undefined) out.activo = !!d.activo;
+  return out;
+}
+
+export async function crearInsumo(d, por) {
+  const datos = validarInsumo(d);
+  const stockInicial = numero(d.stock_actual ?? 0, 'El stock inicial', { max: 1e7 });
+  try {
+    const i = await db.insumos.create({ ...datos, stock_actual: stockInicial, activo: datos.activo ?? true });
+    if (stockInicial > 0) await registrar(i, 'ingreso', stockInicial, 'Stock inicial', por);
+    return conAlerta(i);
+  } catch (e) {
+    if (e.code === 11000) throw conflicto('Ya existe un insumo con ese nombre.');
+    throw e;
+  }
+}
+
+export async function editarInsumo(id, d) {
+  const datos = validarInsumo(d, true);
+  // El stock NO se edita acá: se mueve con movimientos para que quede auditado.
+  try {
+    const i = await db.insumos.update(id, datos);
+    if (!i) throw noEncontrado('Insumo no encontrado');
+    return conAlerta(i);
+  } catch (e) {
+    if (e.code === 11000) throw conflicto('Ya existe un insumo con ese nombre.');
+    throw e;
+  }
+}
+
+export async function borrarInsumo(id) {
+  const usados = await db.products.list({});
+  if (usados.some((p) => (p.receta || []).some((r) => String(r.insumo) === String(id)))) {
+    throw conflicto('El insumo está en la receta de algún plato. Desactivalo o sacalo de la receta primero.');
+  }
+  if (!(await db.insumos.remove(id))) throw noEncontrado('Insumo no encontrado');
+  return { message: 'Insumo eliminado' };
+}
+
+async function registrar(insumo, tipo, cantidad, motivo, por) {
+  return db.movimientos.create({
+    insumo: insumo._id, nombre: insumo.nombre, tipo, cantidad: redondear(cantidad),
+    stock_resultante: redondear(insumo.stock_actual), motivo: motivo || '', por: por || '',
+  });
+}
+
+/**
+ * Movimiento manual de stock.
+ *  ingreso → suma (compra/reposición) · egreso → resta (merma, vencimiento) · ajuste → fija el valor contado
+ */
+export async function moverStock(id, { tipo, cantidad, motivo }, por) {
+  if (!['ingreso', 'egreso', 'ajuste'].includes(tipo)) throw badRequest('Tipo de movimiento inválido.');
+  cantidad = numero(cantidad, 'La cantidad', { min: tipo === 'ajuste' ? 0 : 0.001, max: 1e7 });
+  motivo = texto(motivo, 'El motivo', { max: 200, requerido: tipo !== 'ingreso' });
+  const actual = await db.insumos.get(id);
+  if (!actual) throw noEncontrado('Insumo no encontrado');
+  let nuevo;
+  if (tipo === 'ingreso') nuevo = actual.stock_actual + cantidad;
+  else if (tipo === 'egreso') {
+    if (cantidad > actual.stock_actual) throw badRequest(`No hay tanto stock (disponible: ${redondear(actual.stock_actual)} ${actual.unidad}).`);
+    nuevo = actual.stock_actual - cantidad;
+  } else nuevo = cantidad;
+  const i = await db.insumos.update(id, { stock_actual: redondear(nuevo) });
+  await registrar(i, tipo, tipo === 'ajuste' ? Math.abs(nuevo - actual.stock_actual) : cantidad, motivo, por);
+  return conAlerta(i);
+}
+
+export async function listarMovimientos({ insumo, limit = 200 } = {}) {
+  return db.movimientos.list(insumo ? { insumo } : {}, { sort: { createdAt: -1 }, limit });
+}
+
+/** Resta stock por consumo de producción. Nunca deja negativo: devuelve lo que faltó. */
+export async function consumirInsumo(insumo, cantidad, motivo, por) {
+  const disponible = Math.max(0, insumo.stock_actual);
+  const consumido = Math.min(disponible, cantidad);
+  const faltante = redondear(cantidad - consumido);
+  if (consumido > 0) {
+    const i = await db.insumos.inc(insumo._id, 'stock_actual', -consumido);
+    i.stock_actual = redondear(i.stock_actual);
+    await db.insumos.update(insumo._id, { stock_actual: i.stock_actual });
+    await registrar(i, 'consumo', consumido, motivo, por);
+    return { consumido: redondear(consumido), faltante, stock: i.stock_actual };
+  }
+  return { consumido: 0, faltante, stock: insumo.stock_actual };
+}
+
+/** Devuelve stock (cancelación de un pedido ya descontado). */
+export async function reponerInsumo(insumo, cantidad, motivo, por) {
+  const i = await db.insumos.inc(insumo._id, 'stock_actual', cantidad);
+  const stock = redondear(i.stock_actual);
+  await db.insumos.update(insumo._id, { stock_actual: stock });
+  await registrar({ ...i, stock_actual: stock }, 'reposicion', cantidad, motivo, por);
+}
diff --git a/src/services/usuarios.js b/src/services/usuarios.js
new file mode 100644
index 0000000..7b6536f
--- /dev/null
+++ b/src/services/usuarios.js
@@ -0,0 +1,83 @@
+import bcrypt from 'bcryptjs';
+import { db } from '../store/index.js';
+import { ROLES } from '../models/User.js';
+import { badRequest, conflicto, esEmail, noEncontrado, texto } from '../utils/errores.js';
+
+export const hashear = (password) => bcrypt.hash(password, 10);
+export const comparar = (password, hash) => bcrypt.compare(password, hash);
+
+/** Lo que se le puede mostrar al front: nunca el hash. */
+export function publico(u) {
+  if (!u) return null;
+  const { passwordHash, ...resto } = u;
+  return { ...resto, id: u._id, name: u.nombre, role: u.rol };
+}
+
+export function validarPassword(p) {
+  if (typeof p !== 'string' || p.length < 8) throw badRequest('La contraseña debe tener al menos 8 caracteres.');
+  if (p.length > 100) throw badRequest('La contraseña es demasiado larga.');
+}
+
+export async function crearUsuario({ nombre, email, password, rol = 'cliente', direccion = '', telefono = '' }) {
+  nombre = texto(nombre, 'El nombre', { max: 80 });
+  if (!esEmail(email)) throw badRequest('Email inválido.');
+  email = email.trim().toLowerCase();
+  validarPassword(password);
+  if (!ROLES.includes(rol)) throw badRequest('Rol inválido.');
+  direccion = texto(direccion, 'La dirección', { max: 200, requerido: false });
+  telefono = texto(telefono, 'El teléfono', { max: 30, requerido: false });
+  try {
+    const u = await db.users.create({ nombre, email, passwordHash: await hashear(password), rol, direccion, telefono, activo: true });
+    return publico(u);
+  } catch (e) {
+    if (e.code === 11000) throw conflicto('Ya existe una cuenta con ese email.');
+    throw e;
+  }
+}
+
+export async function actualizarUsuario(id, datos, { esAdmin = false, actorId = null } = {}) {
+  const actual = await db.users.get(id);
+  if (!actual) throw noEncontrado('Usuario no encontrado');
+  const patch = {};
+  if (datos.nombre !== undefined) patch.nombre = texto(datos.nombre, 'El nombre', { max: 80 });
+  if (datos.direccion !== undefined) patch.direccion = texto(datos.direccion, 'La dirección', { max: 200, requerido: false });
+  if (datos.telefono !== undefined) patch.telefono = texto(datos.telefono, 'El teléfono', { max: 30, requerido: false });
+  if (datos.password) { validarPassword(datos.password); patch.passwordHash = await hashear(datos.password); }
+  if (esAdmin) {
+    if (datos.email !== undefined) {
+      if (!esEmail(datos.email)) throw badRequest('Email inválido.');
+      patch.email = datos.email.trim().toLowerCase();
+    }
+    if (datos.rol !== undefined) {
+      if (!ROLES.includes(datos.rol)) throw badRequest('Rol inválido.');
+      if (String(actorId) === String(id) && datos.rol !== actual.rol) throw badRequest('No podés cambiar tu propio rol.');
+      patch.rol = datos.rol;
+    }
+    if (datos.activo !== undefined) {
+      if (String(actorId) === String(id) && datos.activo === false) throw badRequest('No podés desactivarte a vos mismo.');
+      patch.activo = !!datos.activo;
+    }
+  }
+  try {
+    return publico(await db.users.update(id, patch));
+  } catch (e) {
+    if (e.code === 11000) throw conflicto('Ya existe una cuenta con ese email.');
+    throw e;
+  }
+}
+
+export async function borrarUsuario(id, actorId) {
+  if (String(actorId) === String(id)) throw badRequest('No podés borrarte a vos mismo.');
+  const u = await db.users.get(id);
+  if (!u) throw noEncontrado('Usuario no encontrado');
+  if (u.rol === 'admin' && (await db.users.count({ rol: 'admin', activo: true })) <= 1) {
+    throw badRequest('Tiene que quedar al menos un administrador activo.');
+  }
+  // Si ya hizo pedidos, se desactiva en vez de borrar (el historial no queda huérfano).
+  if (await db.orders.count({ userId: id })) {
+    await db.users.update(id, { activo: false });
+    return { message: 'El usuario tiene pedidos: se desactivó en lugar de borrarse.', desactivado: true };
+  }
+  await db.users.remove(id);
+  return { message: 'Usuario eliminado' };
+}
